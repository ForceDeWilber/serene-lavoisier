[Unit]
Description=Serene Lavoisier Pure Rust Decision & Execution Engine Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/serene-lavoisier
EnvironmentFile=/home/ubuntu/serene-lavoisier/.env
ExecStart=/home/ubuntu/serene-lavoisier/target/release/engine-daemon
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rust-engine

# Process Limits & Sandboxing
LimitNOFILE=65536
LimitNPROC=4096
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/serene-lavoisier /tmp

[Install]
WantedBy=multi-user.target

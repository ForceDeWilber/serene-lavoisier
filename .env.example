# ==============================================================================
# SERENE LAVOISIER // MULTI-VENUE TRADING ENVIRONMENT CONFIGURATION
# ==============================================================================

# Mode: "PAPER" (simulated execution against live market) or "LIVE" (real capital)
TRADING_MODE=PAPER

# Revolut X Exchange Authentication (Required for Live Execution)
# 1. Generate keypair: openssl genpkey -algorithm ed25519 -out backend/credentials/revolut_private.pem
# 2. Extract public key: openssl pkey -in backend/credentials/revolut_private.pem -pubout -out backend/credentials/revolut_public.pem
# 3. Upload public.pem to Revolut X web portal -> API Keys
REVOLUT_API_KEY=0fEG_your_64_character_revolut_api_key_here
REVOLUT_PRIVATE_KEY_PATH=backend/credentials/revolut_private.pem

# Kraken Pro Market Data
# Note: Kraken Pro public WebSocket & REST ticker feeds do NOT require any API keys!
# All Kraken oracle price feeds are free, public, and unauthenticated.

# Risk Management Defaults
MAX_POSITION_PER_ASSET_GBP=500.00
MAX_DRAWDOWN_CIRCUIT_BREAKER_PCT=5.0

# Optional Discord Bot Telemetry Alerts
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ==============================================================================
# SERENE LAVOISIER // MULTI-VENUE TRADING ENVIRONMENT CONFIGURATION
# ==============================================================================

# Mode for this host:
# - "LIVE": Runs dedicated Live execution on Revolut X (Zero backtesting / zero contention)
# - "PAPER": Runs isolated Paper Strategy Sandbox & Backtesting Laboratory
# - "DUAL": Local dev only (runs both runners concurrently on localhost)
TRADING_MODE=LIVE

# Revolut X Exchange Authentication (Strictly Required for Live Execution)
# 1. Generate keypair: openssl genpkey -algorithm ed25519 -out backend/credentials/revolut_private.pem
# 2. Extract public key: openssl pkey -in backend/credentials/revolut_private.pem -pubout -out backend/credentials/revolut_public.pem
# 3. Upload public.pem to Revolut X web portal -> API Keys
REVOLUT_API_KEY=vjxb515OQVkc5A0X1aJqP5xhu5ajwD3mp293lqyLYOd1vbktQT4H88bGscZdIXRQ
REVOLUT_PRIVATE_KEY_PATH=backend/credentials/revolut_private.pem

# Host Isolation URLs for Next.js BFF Proxy (trader.wilbergoose.com)
# Live requests (mode=live) route directly to your dedicated engine host (localhost:8000 for local dev, or Lightsail in cloud):
LIVE_ENGINE_URL=http://localhost:8000
# Paper/Backtest requests (mode=paper) route to your sandbox instance or localhost:
PAPER_ENGINE_URL=http://localhost:8000
# Default fallback URL:
ENGINE_URL=http://localhost:8000

# Frontend Defaults
NEXT_PUBLIC_DEFAULT_MODE=live
NEXT_PUBLIC_TRADING_MODE=LIVE

# Security Tokens
ENGINE_SECRET_KEY=change_this_to_a_secure_random_hex_string
DASHBOARD_PIN=123457

# Kraken Pro Market Data
# Note: Kraken Pro public WebSocket & REST ticker feeds do NOT require any API keys!
# All Kraken oracle price feeds are free, public, and unauthenticated.
KRAKEN_WS_URL=wss://ws.kraken.com/v2

# Risk Management Defaults
MAX_POSITION_PER_ASSET_GBP=500.00
MAX_DRAWDOWN_CIRCUIT_BREAKER_PCT=5.0

# Optional Discord Bot Telemetry Alerts
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
